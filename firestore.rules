# Shortlink Admin — Firestore Security Rules
# For the shortlink-data Firebase project
# Deploy via Firebase Console → Firestore Database → Rules

service cloud.firestore {
  match /databases/{database}/documents {
    // Stats document — publicly readable (no sign-in admin page)
    match /stats/overview {
      allow read: if true;
      allow write: if false;
    }

    // All other documents — deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
